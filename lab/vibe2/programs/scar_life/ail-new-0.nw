fn is_digit(c: str) -> bool:
  if c == "0":
    return True
  if c == "1":
    return True
  if c == "2":
    return True
  if c == "3":
    return True
  if c == "4":
    return True
  if c == "5":
    return True
  if c == "6":
    return True
  if c == "7":
    return True
  if c == "8":
    return True
  if c == "9":
    return True
  return False

fn code_value(c: str) -> int:
  if is_digit(c):
    return int(c)
  if c == "A":
    return 10
  if c == "B":
    return 11
  if c == "C":
    return 12
  return -1

fn parse_codes(s: str) -> Result[list[int]]:
  let flags: list[int] = []
  var k: int = 0
  while k < 13:
    flags.append(0)
    k = k + 1
  var prev: int = -1
  var i: int = 0
  while i < len(s):
    let v: int = code_value(s[i])
    if v < 0:
      return Err("bad weight code")
    if v <= prev:
      return Err("not strictly increasing")
    prev = v
    flags[v] = 1
    i = i + 1
  return Ok(flags)

fn parse_rule(rule: str) -> Result[list[list[int]]]:
  if len(rule) == 0:
    return Err("empty rule")
  if rule[0] != "B":
    return Err("missing B")
  var slash: int = -1
  var i: int = 1
  while i < len(rule):
    if rule[i] == "/":
      slash = i
      break
    i = i + 1
  if slash < 0:
    return Err("missing slash")
  if slash + 1 >= len(rule):
    return Err("missing S")
  if rule[slash + 1] != "S":
    return Err("missing S")
  let bstr: str = rule[1:slash]
  let sstr: str = rule[slash + 2:len(rule)]
  var b_list: list[int] = []
  var s_list: list[int] = []
  match parse_codes(bstr):
    case Ok(bl):
      b_list = bl
    case Err(e):
      return Err(e)
  match parse_codes(sstr):
    case Ok(sl):
      s_list = sl
    case Err(e):
      return Err(e)
  let res: list[list[int]] = []
  res.append(b_list)
  res.append(s_list)
  return Ok(res)

fn parse_gens(s: str) -> Result[int]:
  if len(s) == 0:
    return Err("empty gens")
  var val: int = 0
  var i: int = 0
  while i < len(s):
    if not is_digit(s[i]):
      return Err("bad gens")
    let d: int = int(s[i])
    if val <= 100000:
      val = val * 10 + d
      if val > 100000:
        val = 100001
    i = i + 1
  if val > 100000:
    return Err("gens too large")
  return Ok(val)

fn parse_dim(s: str) -> Result[int]:
  if len(s) == 0:
    return Err("empty dimension")
  if len(s) > 1:
    if s[0] == "0":
      return Err("leading zero")
  var val: int = 0
  var i: int = 0
  while i < len(s):
    if not is_digit(s[i]):
      return Err("bad dimension")
    let d: int = int(s[i])
    if val <= 4096:
      val = val * 10 + d
      if val > 4096:
        val = 4097
    i = i + 1
  if val < 1:
    return Err("dimension too small")
  if val > 4096:
    return Err("dimension too large")
  return Ok(val)

fn parse_input(text: str) -> Result[list[int]]:
  let n: int = len(text)
  var nl: int = -1
  var i: int = 0
  while i < n:
    if text[i] == "\n":
      nl = i
      break
    i = i + 1
  if nl < 0:
    return Err("missing header line")
  let header: str = text[0:nl]
  let rest: str = text[nl + 1:n]
  var sp: int = -1
  var j: int = 0
  var bad: bool = False
  while j < len(header):
    if header[j] == " ":
      if sp >= 0:
        bad = True
        break
      sp = j
    j = j + 1
  if bad:
    return Err("multiple spaces")
  if sp < 0:
    return Err("missing space")
  let wstr: str = header[0:sp]
  let hstr: str = header[sp + 1:len(header)]
  var W: int = 0
  var H: int = 0
  match parse_dim(wstr):
    case Ok(wv):
      W = wv
    case Err(e):
      return Err(e)
  match parse_dim(hstr):
    case Ok(hv):
      H = hv
    case Err(e):
      return Err(e)
  if len(rest) == 0:
    return Err("missing rows")
  let lastc: str = rest[len(rest) - 1]
  let ends_nl: bool = lastc == "\n"
  let parts: list[str] = rest.split("\n")
  if ends_nl:
    if len(parts) != H + 1:
      return Err("row count mismatch")
    if parts[H] != "":
      return Err("trailing data")
  else:
    if len(parts) != H:
      return Err("row count mismatch")
  let res: list[int] = []
  res.append(W)
  res.append(H)
  var r: int = 0
  while r < H:
    let row: str = parts[r]
    if len(row) != W:
      return Err("row width mismatch")
    var c: int = 0
    while c < W:
      let ch: str = row[c]
      if ch == ".":
        res.append(0)
      elif ch == "o":
        res.append(1)
      else:
        return Err("bad cell character")
      c = c + 1
    r = r + 1
  return Ok(res)

fn step(grid: list[int], W: int, H: int, b_list: list[int], s_list: list[int]) -> list[int]:
  let n: int = W * H
  let out: list[int] = []
  var q: int = 0
  while q < n:
    out.append(0)
    q = q + 1
  var r: int = 0
  while r < H:
    var rup: int = r - 1
    if rup < 0:
      rup = H - 1
    var rdn: int = r + 1
    if rdn >= H:
      rdn = 0
    let brow: int = r * W
    let uprow: int = rup * W
    let dnrow: int = rdn * W
    var c: int = 0
    while c < W:
      var cl: int = c - 1
      if cl < 0:
        cl = W - 1
      var cr: int = c + 1
      if cr >= W:
        cr = 0
      var w: int = 0
      if grid[uprow + c] == 1:
        w = w + 2
      if grid[dnrow + c] == 1:
        w = w + 2
      if grid[brow + cl] == 1:
        w = w + 2
      if grid[brow + cr] == 1:
        w = w + 2
      if grid[uprow + cl] == 1:
        w = w + 1
      if grid[uprow + cr] == 1:
        w = w + 1
      if grid[dnrow + cl] == 1:
        w = w + 1
      if grid[dnrow + cr] == 1:
        w = w + 1
      let old: int = grid[brow + c]
      var nv: int = 0
      if old == 1:
        if s_list[w] == 1:
          nv = 1
        else:
          nv = 2
      elif old == 0:
        if b_list[w] == 1:
          nv = 1
        else:
          nv = 0
      else:
        nv = 0
      out[brow + c] = nv
      c = c + 1
    r = r + 1
  return out

if arg_count() != 2:
  exit(1)
let rule_s: str = arg(0)
let gens_s: str = arg(1)
var b_list: list[int] = []
var s_list: list[int] = []
match parse_rule(rule_s):
  case Ok(pair):
    b_list = pair[0]
    s_list = pair[1]
  case Err(e):
    exit(1)
var gens: int = 0
match parse_gens(gens_s):
  case Ok(v):
    gens = v
  case Err(e):
    exit(1)
var W: int = 0
var H: int = 0
var grid: list[int] = []
match parse_input(read_stdin()):
  case Ok(data):
    W = data[0]
    H = data[1]
    var k: int = 2
    while k < len(data):
      grid.append(data[k])
      k = k + 1
  case Err(e):
    exit(1)
var g: int = 1
while g <= gens:
  grid = step(grid, W, H, b_list, s_list)
  var a: int = 0
  var sc: int = 0
  var idx: int = 0
  while idx < len(grid):
    if grid[idx] == 1:
      a = a + 1
    elif grid[idx] == 2:
      sc = sc + 1
    idx = idx + 1
  write(str(g) + " " + str(a) + " " + str(sc) + "\n")
  g = g + 1
var rr: int = 0
while rr < H:
  var line: str = ""
  var cc: int = 0
  while cc < W:
    let vv: int = grid[rr * W + cc]
    if vv == 0:
      line = line + "."
    elif vv == 1:
      line = line + "o"
    else:
      line = line + "x"
    cc = cc + 1
  write(line + "\n")
  rr = rr + 1
exit(0)
