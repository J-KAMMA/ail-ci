# Rival toolchain versions compare-rival pins. Install exactly these; results from other versions
# are not comparable. PYTHON and GCC are the compare-lab pins, reused here.
PYTHON=3.12
GCC=13.3.0
# pip/PyPI (official wheels)
CYTHON=3.3.1
MYPY=2.4.1
NUITKA=4.3.4
SETUPTOOLS=75.8.0
# Codon: official release tarball, github.com/exaloop/codon v0.20.6, codon-linux-x86_64.tar.gz.
# The tarball itself ships no LICENSE file; the repository at that tag carries Apache-2.0.
CODON=0.20.6
# PyPy: prebuilt interpreter tarball from downloads.python.org/pypy, not a compiler of AIL's source
# language. PyPy 7.3.23 implements Python 3.11.15 (the `--version` line above the PyPy line). MIT.
# Published checksum: downloads.python.org/pypy has no .sha256 file beside the tarball, so the digest
# below is the one this run downloaded and unpacked; the workflow re-checks it and fails on a
# mismatch rather than trusting a silent re-upload.
PYPY=7.3.23
PYPY_PYTHON=3.11.15
PYPY_TARBALL=https://downloads.python.org/pypy/pypy3.11-v7.3.23-linux64.tar.bz2
PYPY_SHA256=16f9f56e82d1f4ec95a324c1a8cacfd78afc7f0656c0a809a18725ef4391453a
