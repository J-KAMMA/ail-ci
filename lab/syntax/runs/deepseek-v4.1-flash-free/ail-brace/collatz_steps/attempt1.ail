```
fn collatz(n: int) -> int {
    if n == 1 {
        return 0;
    }
    if n % 2 == 0 {
        return 1 + collatz(n / 2);
    }
    return 1 + collatz(3 * n + 1);
}

fn main() -> int {
    for line in sys.stdin {
        let s = line.strip();
        if len(s) > 0 {
            print(collatz(int(s)));
        }
    }
    return 0;
}
```
