```
fn fib(n: int, m: int) -> int {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let c = (a + b) % m;
        a = b;
        b = c;
        i += 1;
    }
    return a % m;
}

fn main() -> int {
    for line in sys.stdin {
        let f = line.split();
        if len(f) == 2 {
            let n = int(f[0]);
            let m = int(f[1]);
            print(fib(n, m));
        }
    }
    return 0;
}
```
