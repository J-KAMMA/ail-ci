```
# inventory_report

struct Item { name: str; quantity: int; unit_price: int; }

fn item_value(it: Item) -> int {
    return it.quantity * it.unit_price;
}

fn main() -> int {
    let names: list[str] = [];
    let values: list[int] = [];
    let total = 0;
    for line in sys.stdin {
        let f = line.split();
        if len(f) >= 3 {
            let it = Item(f[0], int(f[1]), int(f[2]));
            let v = item_value(it);
            names.append(it.name);
            values.append(v);
            total += v;
        }
    }
    let order: list[int] = [];
    let i = 0;
    while i < len(names) {
        order.append(i);
        i += 1;
    }
    order.sort(key=lambda j: (-values[j], names[j]));
    for j in order {
        print(names[j], values[j]);
    }
    print("total", total);
    return 0;
}
```
