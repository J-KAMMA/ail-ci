```python
import sys

def main() -> int:
    totals: dict[str, int] = {}
    for line in sys.stdin:
        f = line.split()
        if len(f) < 2:
            continue
        name: str = f[0]
        amount: int = int(f[1])
        if name in totals:
            totals[name] += amount
        else:
            totals[name] = amount
    for key in sorted(totals):
        print(key, totals[key])
    return 0
```
