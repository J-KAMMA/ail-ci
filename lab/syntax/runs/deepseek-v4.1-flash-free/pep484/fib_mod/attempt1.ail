```
import sys

def fib_mod(n: int, m: int) -> int:
    a: int = 0
    b: int = 1
    i: int = 0
    while i < n:
        t: int = (a + b) % m
        a = b
        b = t
        i += 1
    return a

def main() -> int:
    for line in sys.stdin:
        f = line.split()
        if len(f) < 2:
            continue
        try:
            n: int = int(f[0])
            m: int = int(f[1])
        except ValueError as e:
            continue
        print(fib_mod(n, m))
    return 0
```
