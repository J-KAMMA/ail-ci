```
import sys

def norm(s: str) -> str:
    out: str = ""
    i: int = 0
    while i < len(s):
        ch: str = s[i]
        if ch.isalnum():
            out += ch.lower()
        i += 1
    return out

def is_pal(s: str) -> bool:
    i: int = 0
    j: int = len(s) - 1
    while i < j:
        if s[i] != s[j]:
            return False
        i += 1
        j -= 1
    return True

def main() -> int:
    for line in sys.stdin:
        t: str = norm(line)
        if is_pal(t):
            print("yes")
        else:
            print("no")
    return 0

if __name__ == "__main__":
    main()
