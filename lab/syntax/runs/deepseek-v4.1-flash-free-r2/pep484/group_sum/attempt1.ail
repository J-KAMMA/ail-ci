```
import sys

def main() -> int:
    totals: dict[str, int] = {}
    for line in sys.stdin:
        f = line.split()
        if len(f) < 2:
            continue
        name: str = f[0]
        try:
            amount: int = int(f[1])
        except ValueError:
            continue
        totals[name] = totals.get(name, 0) + amount
    for name in sorted(totals):
        print(name, totals[name])
    return 0

if __name__ == "__main__":
    main()
```
