```
fn main() -> int {
    let totals: dict[str, int] = {};
    for line in sys.stdin {
        let f = line.split();
        if len(f) >= 2 {
            let name = f[0];
            let amount = int(f[1]);
            let cur = totals.get(name, 0);
            totals[name] = cur + amount;
        }
    }
    for k in sorted(totals) {
        print(k, totals[k]);
    }
    return 0;
}
```
