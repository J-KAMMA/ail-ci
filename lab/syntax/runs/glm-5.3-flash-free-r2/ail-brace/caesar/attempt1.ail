```ail
const LOWER = "abcdefghijklmnopqrstuvwxyz";
const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

fn shift_char(ch: str, k: int) -> str {
    let j: int = UPPER.find(ch);
    if j >= 0 {
        return UPPER[(j + k) % 26];
    }
    let m: int = LOWER.find(ch);
    if m >= 0 {
        return LOWER[(m + k) % 26];
    }
    return ch;
}

fn shift_line(text: str, k: int) -> str {
    let n: int = len(text);
    let out: str = "";
    let i: int = 0;
    while i < n {
        out = out + shift_char(text[i], k);
        i += 1;
    }
    return out;
}

fn main() -> int {
    let k: int = 0;
    let seen: int = 0;
    let text: str = "";
    for line in sys.stdin {
        if seen == 0 {
            k = int(line.strip());
        } else {
            text = line.replace("\n", "");
            print(shift_line(text, k));
        }
        seen += 1;
    }
    return 0;
}
