```
fn collatz_steps(n: int) -> int {
    let steps = 0;
    let m = n;
    while m > 1 {
        if m % 2 == 0 {
            m = m / 2;
        } else {
            m = 3 * m + 1;
        }
        steps += 1;
    }
    return steps;
}

fn main() -> int {
    for line in sys.stdin {
        let s = line.strip();
        if s != "" {
            try {
                let n = int(s);
                if n >= 1 {
                    let steps = collatz_steps(n);
                    print(steps);
                }
            }
            except ValueError as err {
                print("bad", err.message);
            }
        }
    }
    return 0;
}
