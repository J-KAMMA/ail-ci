```python
import sys

LIMIT: int = 100000

def build_counts(limit: int) -> list[int]:
    is_prime: list[bool] = [True] * (limit + 1)
    is_prime[0] = False
    is_prime[1] = False
    i: int = 2
    while i * i <= limit:
        if is_prime[i]:
            j: int = i * i
            while j <= limit:
                is_prime[j] = False
                j += i
        i += 1
    counts: list[int] = [0] * (limit + 1)
    c: int = 0
    for k in range(limit + 1):
        if is_prime[k]:
            c += 1
        counts[k] = c
    return counts

def main() -> int:
    counts: list[int] = build_counts(LIMIT)
    for line in sys.stdin:
        s: str = line.strip()
        if not s:
            continue
        n: int = int(s)
        print(counts[n])
    return 0

if __name__ == "__main__":
    main()
```
