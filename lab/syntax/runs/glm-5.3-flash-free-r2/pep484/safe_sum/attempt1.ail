```python
import sys

DIGITS = "0123456789"

def is_int_token(tok: str) -> bool:
    body: str = tok
    if len(tok) > 0 and tok[0] == "-":
        body = tok[1:]
    if len(body) == 0:
        return False
    for ch in body:
        if DIGITS.find(ch) < 0:
            return False
    return True

def main() -> int:
    toks: list[str] = []
    for line in sys.stdin:
        for p in line.split():
            toks.append(p)
    total: int = 0
    for tok in toks:
        if is_int_token(tok):
            total += int(tok)
        else:
            print("bad: " + tok)
    print("sum=" + str(total))
    return 0

if __name__ == "__main__":
    main()
```
