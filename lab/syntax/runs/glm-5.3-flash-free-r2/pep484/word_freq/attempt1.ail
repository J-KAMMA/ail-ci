```python
import sys

def main() -> int:
    counts: dict[str, int] = {}
    for line in sys.stdin:
        for tok in line.split():
            w = tok.lower()
            counts[w] = counts.get(w, 0) + 1
    words: list[str] = []
    for w in counts:
        words.append(w)
    words.sort(key=lambda t: (-counts[t], t))
    for w in words:
        print(w, counts[w])
    return 0

if __name__ == "__main__":
    main()
```
