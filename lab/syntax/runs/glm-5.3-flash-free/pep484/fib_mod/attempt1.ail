```python
import sys


def fib_mod(n: int, m: int) -> int:
    a: int = 0 % m
    b: int = 1 % m
    if n == 0:
        return a
    i: int = 1
    while i < n:
        c: int = (a + b) % m
        a = b
        b = c
        i += 1
    return b


def main() -> int:
    for line in sys.stdin:
        parts: list[str] = line.split()
        if len(parts) < 2:
            continue
        n: int = int(parts[0])
        m: int = int(parts[1])
        print(fib_mod(n, m))
    return 0
```
