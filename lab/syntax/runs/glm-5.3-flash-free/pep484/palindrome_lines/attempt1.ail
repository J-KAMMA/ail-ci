```python
import sys

UP: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
LOW: str = "abcdefghijklmnopqrstuvwxyz0123456789"

def clean(s: str) -> str:
    parts: list[str] = []
    i: int = 0
    n: int = len(s)
    while i < n:
        ch: str = s[i]
        p: int = UP.find(ch)
        if p >= 0:
            parts.append(LOW[p])
        else:
            q: int = LOW.find(ch)
            if q >= 0:
                parts.append(ch)
        i += 1
    return "".join(parts)

def is_pal(text: str) -> bool:
    n: int = len(text)
    lo: int = 0
    hi: int = n - 1
    while lo < hi:
        if text[lo] != text[hi]:
            return False
        lo += 1
        hi -= 1
    return True

def main() -> int:
    for line in sys.stdin:
        cleaned: str = clean(line.strip())
        if is_pal(cleaned):
            print("yes")
        else:
            print("no")
    return 0
```
