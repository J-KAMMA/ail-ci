```ail
fn num_steps(n: int) -> int {
    let v = n;
    let h = 0;
    let c = 0;
    while v > 1 {
        h = v / 2;
        if h + h == v {
            v = h;
        } else {
            v = v + v + v + 1;
        }
        c = c + 1;
    }
    return c;
}

fn main() -> int {
    for line in sys.stdin {
        let s = line.strip();
        if len(s) > 0 {
            let n = int(s);
            print(num_steps(n));
        }
    }
    return 0;
}
