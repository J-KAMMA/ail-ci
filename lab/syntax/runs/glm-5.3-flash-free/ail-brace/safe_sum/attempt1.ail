```
# safe_sum: print `bad: TOKEN` for garbage tokens, then `sum=S`.

fn is_int_token(s: str) -> bool {
    let body = s;
    if len(s) > 0 and s[0] == "-" {
        body = s[1:];
    }
    if len(body) == 0 {
        return false;
    }
    return body.isdigit();
}

fn main() -> int {
    let total = 0;
    for line in sys.stdin {
        let parts = line.split();
        for tok in parts {
            if not is_int_token(tok) {
                print("bad:", tok);
            } else {
                try {
                    total += int(tok);
                } except ValueError as err {
                    print("bad:", tok);
                }
            }
        }
    }
    print(f"sum={total}");
    return 0;
}
```
