```ail
fn main() -> int {
    for line in sys.stdin {
        let parts = line.split();
        if len(parts) == 0 {
            continue;
        }
        let outs: list[str] = [];
        let cur = int(parts[0]);
        outs.append(str(cur));
        for i in range(1, len(parts)) {
            let v = int(parts[i]);
            if v > cur {
                cur = v;
            }
            outs.append(str(cur));
        }
        print(" ".join(outs));
    }
    return 0;
}
```
