use json_pointer;
use json_tree;

# Pointer queries answered in one validating pass over UTF-8 bytes, without building a node list.
# Every JSON structure character is ASCII and an ASCII byte never occurs inside a multi-byte
# character, so the scan reads bytes and follows json_parse_document byte for byte: string bodies
# run to the first unescaped quote, everything else is structure and literal tokens. A value is a
# byte span, cut from the input as an O(1) view and decoded only to render the pointer targets.
# A pointer error never interrupts the scan: the document is validated first, then the pointer
# errors surface in pointer order, as json_pointer_batch reports them. The helpers take struct
# lists, because a str list passed to a function is copied.
struct JsonPointerValues { error: int; values: list[str]; }

# Per pointer: its first segment in `segs`, segment count, status (0 ok, 1 ValueError,
# 3 KeyError) and the byte span of its target (end -1 until found). Scan cursors are kept for
# the open containers only; a cursor at a container sits at the depth of that container, so its
# next token is segment `depth`. A `done` cursor marks a target whose span ends when the
# container closes.
struct JsonScanPointer { first: int; count: int; status: int; s: int; e: int; }
struct JsonScanSegment { text: str; index: int; raw: bytes; }
struct JsonScanCursor { pointer: int; matches: int; done: int; }

# Array index of a segment: -1 not an index (ValueError), -2 "-" or too large (KeyError).
fn _json_scan_index(token: str) -> int {
    if token == "-" { return -2; }
    let length: int = len(token);
    if length == 0 { return -1; }
    let value: int = 0;
    let first: int = 1;
    for c in token {
        let digit: int = ord(c) - 48;
        if digit < 0 or digit > 9 { return -1; }
        if first and digit == 0 and length != 1 { return -1; }
        first = 0;
        if length <= 18 { value = value * 10 + digit; }
    }
    if length > 18 { return -2; }
    return value;
}

fn _json_scan_next(state: int) -> int {
    if state == 0 { return 9; }
    if state == 1 or state == 2 { return 3; }
    if state == 7 { return 8; }
    raise ValueError;
}

# _json_literal_kind over data[lo:hi]: a valid token is ASCII, so its bytes are read directly.
fn _json_scan_literal_kind(data: bytes, lo: int, hi: int) -> int {
    let length: int = hi - lo;
    if length == 4 and data[lo] == 110 and data[lo + 1] == 117 and data[lo + 2] == 108 and data[lo + 3] == 108 { return 0; }
    if length == 4 and data[lo] == 116 and data[lo + 1] == 114 and data[lo + 2] == 117 and data[lo + 3] == 101 { return 1; }
    if length == 5 and data[lo] == 102 and data[lo + 1] == 97 and data[lo + 2] == 108 and data[lo + 3] == 115 and data[lo + 4] == 101 { return 1; }
    let state: int = 0;
    for k in range(lo, hi) {
        let c: int = data[k];
        let digit: int = c >= 48 and c <= 57;
        if state == 0 or state == 1 {
            if c == 45 and state == 0 { state = 1; }
            elif c == 48 { state = 2; }
            elif digit { state = 3; }
            else { raise ValueError; }
        } elif state == 2 or state == 3 {
            if digit and state == 3 { state = 3; }
            elif c == 46 { state = 4; }
            elif c == 101 or c == 69 { state = 6; }
            else { raise ValueError; }
        } elif state == 4 or state == 7 {
            if not digit { raise ValueError; }
            if state == 4 { state = 5; } else { state = 8; }
        } elif state == 5 {
            if digit { state = 5; }
            elif c == 101 or c == 69 { state = 6; }
            else { raise ValueError; }
        } elif state == 6 {
            if c == 43 or c == 45 { state = 7; }
            elif digit { state = 8; }
            else { raise ValueError; }
        } else {
            if not digit { raise ValueError; }
        }
    }
    if state != 2 and state != 3 and state != 5 and state != 8 { raise ValueError; }
    return 2;
}

# Validate the string body data[lo:hi] (between the quotes) that holds a backslash, exactly as
# json_unquote does, without decoding.
fn _json_scan_check_body(data: bytes, lo: int, hi: int) -> void {
    # States: content, escape, hex, high slash, high u, low hex.
    let state: int = 1;
    let value: int = 0;
    let remaining: int = 0;
    for k in range(lo, hi) {
        let c: int = data[k];
        if state == 1 {
            if c < 32 { raise ValueError; }
            if c == 92 { state = 2; }
        } elif state == 2 {
            state = 1;
            if c == 117 { state = 3; value = 0; remaining = 4; }
            elif c != 34 and c != 92 and c != 47 and c != 98 and c != 102 and c != 110 and c != 114 and c != 116 {
                raise ValueError;
            }
        } elif state == 3 or state == 6 {
            let digit: int = -1;
            if c >= 48 and c <= 57 { digit = c - 48; }
            elif c >= 65 and c <= 70 { digit = c - 55; }
            elif c >= 97 and c <= 102 { digit = c - 87; }
            if digit < 0 { raise ValueError; }
            value = value * 16 + digit;
            remaining -= 1;
            if remaining == 0 {
                if state == 6 {
                    if value < 56320 or value > 57343 { raise ValueError; }
                    state = 1;
                } elif value >= 55296 and value <= 56319 { state = 4; }
                elif value >= 56320 and value <= 57343 { raise ValueError; }
                else { state = 1; }
            }
        } elif state == 4 {
            if c != 92 { raise ValueError; }
            state = 5;
        } else {
            if c != 117 { raise ValueError; }
            state = 6; value = 0; remaining = 4;
        }
    }
    if state != 1 { raise ValueError; }
}

# A value reached pointer `p` at `depth`: record the target, or continue into a container.
# Spans are byte offsets: the value is data[s:e], or e = -1 while its container is still open.
fn _json_scan_hit(ptrs: list[JsonScanPointer], segs: list[JsonScanSegment], act: list[JsonScanCursor], p: int,
                  depth: int, cont: int, s: int, e: int) -> void {
    let ptr: JsonScanPointer = ptrs[p];
    if ptr.count == depth {
        ptr.s = s;
        if cont != 0 { act.append(JsonScanCursor(p, 0, 1)); }
        else { ptr.e = e; }
    } elif cont == 0 { ptr.status = 3; }
    else {
        if cont == 1 {
            let code: int = segs[ptr.first + depth].index;
            if code < 0 {
                if code == -1 { ptr.status = 1; } else { ptr.status = 3; }
                return;
            }
        }
        act.append(JsonScanCursor(p, 0, 0));
    }
}

# A value starts (`cont` 0 scalar, 1 array, 2 object) under the frame whose cursors begin at `top`.
# In state 7 the member key is data[ks:ke] when `kesc` is 0, else the unescaped `key`.
fn _json_scan_leaf(ptrs: list[JsonScanPointer], segs: list[JsonScanSegment], act: list[JsonScanCursor],
                   data: bytes, state: int, kesc: int, key: str, ks: int, ke: int, elem: int, top: int, depth: int,
                   cont: int, s: int, e: int, lw: int) -> void {
    if state == 0 {
        for p in range(len(ptrs)) {
            if ptrs[p].status == 0 { _json_scan_hit(ptrs, segs, act, p, depth, cont, s, e); }
        }
        return;
    }
    let end: int = len(act);
    for i in range(top, end) {
        let cursor: JsonScanCursor = act[i];
        if cursor.done == 0 {
            let at: int = ptrs[cursor.pointer].first + depth - 1;
            let hit: int = 0;
            if state == 7 {
                if kesc != 0 {
                    if segs[at].text == key { cursor.matches += 1; hit = 1; }
                } elif data[ks:ke] == segs[at].raw { cursor.matches += 1; hit = 1; }
                # Last wins: a repeated member replaces what the earlier one left for this pointer.
                if lw != 0 and hit and cursor.matches > 1 {
                    let again: JsonScanPointer = ptrs[cursor.pointer];
                    again.status = 0; again.s = 0; again.e = -1;
                }
            } elif segs[at].index == elem { hit = 1; }
            if hit { _json_scan_hit(ptrs, segs, act, cursor.pointer, depth, cont, s, e); }
        }
    }
}

# The container of depth `d` closes with its last byte before `e`: end its targets and judge its cursors.
fn _json_scan_close(ptrs: list[JsonScanPointer], segs: list[JsonScanSegment], act: list[JsonScanCursor], top: int,
                    d: int, arr: int, elem: int, e: int, lw: int) -> void {
    for i in range(top, len(act)) {
        let cursor: JsonScanCursor = act[i];
        let ptr: JsonScanPointer = ptrs[cursor.pointer];
        if cursor.done { ptr.e = e; }
        elif arr {
            if segs[ptr.first + d].index >= elem { ptr.status = 3; }
        } elif cursor.matches != 1 {
            if cursor.matches > 1 {
                if lw == 0 { ptr.status = 1; }
            } else { ptr.status = 3; }
        }
    }
}

# Validate `data` (UTF-8 text; a precondition, callers decode it first) once, then answer every
# pointer. A document error raises ValueError; a pointer error is returned as `error` (1 ValueError,
# 3 KeyError) with the pointers' compact renderings left empty, so a caller can tell the two stages apart.
fn json_pointer_scan_bytes(data: bytes, pointers: list[str]) -> JsonPointerValues {
    return _json_scan_run(data, pointers, 0, 0);
}

# Like json_pointer_scan_bytes, but a member name repeated in an object selects the LAST occurrence
# (whether or not the pointer goes through the object; compact output keeps every member in document
# order) and a document nested deeper than `max_depth` containers raises ValueError (0: no limit).
fn json_pointer_scan_last_wins(data: bytes, pointers: list[str], max_depth: int) -> JsonPointerValues {
    return _json_scan_run(data, pointers, 1, max_depth);
}

fn _json_scan_run(data: bytes, pointers: list[str], lw: int, maxd: int) -> JsonPointerValues {
    let ptrs: list[JsonScanPointer] = [];
    let segs: list[JsonScanSegment] = [];
    for pointer in pointers {
        let first: int = len(segs);
        let count: int = 0;
        let status: int = 0;
        try {
            let segments: list[str] = json_pointer_segments(pointer);
            for token in segments { segs.append(JsonScanSegment(token, _json_scan_index(token), token.encode("utf-8"))); }
            count = len(segments);
        } except ValueError { status = 1; }
        ptrs.append(JsonScanPointer(first, count, status, 0, -1));
    }
    let act: list[JsonScanCursor] = [];
    let frames: list[int] = [];
    let state: int = 0; let elem: int = 0; let top: int = 0; let depth: int = 0;
    let key: str = ""; let kesc: int = 0; let ks: int = 0; let ke: int = 0;
    let n: int = len(data);
    let i: int = 0;
    let start: int = -1;
    while i <= n {
        # Position n is a virtual end: it only flushes a pending token.
        let b: int = -1;
        if i < n { b = data[i]; }
        if b >= 45 and b != 58 and b != 91 and b != 93 and b != 123 and b != 125 {
            if start < 0 { start = i; }
            i += 1; continue;
        }
        let space = b == 32 or b == 9 or b == 13 or b == 10;
        let punctuation = b == 91 or b == 93 or b == 123 or b == 125 or b == 44 or b == 58;
        if b >= 0 and b != 34 and not space and not punctuation {
            if start < 0 { start = i; }
            i += 1; continue;
        }
        if start >= 0 {
            _json_scan_literal_kind(data, start, i);
            let next: int = _json_scan_next(state);
            if state == 0 or len(act) > top {
                _json_scan_leaf(ptrs, segs, act, data, state, kesc, key, ks, ke, elem, top, depth, 0, start, i, lw);
            }
            if state == 1 or state == 2 { elem += 1; }
            state = next;
            start = -1;
        }
        if b < 0 { break; }
        if space { i += 1; continue; }
        if b == 34 {
            # String body: up to the first quote that is not escaped.
            let j: int = i + 1;
            let backslash: int = 0;
            while true {
                if j >= n { raise ValueError; }
                let c: int = data[j];
                if c == 34 { break; }
                if c == 92 { backslash = 1; j += 2; continue; }
                if c < 32 { raise ValueError; }
                j += 1;
            }
            if state == 4 or state == 5 {
                if backslash != 0 {
                    key = json_unquote("\"" + data[i + 1:j].decode("utf-8") + "\"");
                    kesc = 1;
                } else { kesc = 0; ks = i + 1; ke = j; }
                state = 6;
            } else {
                if backslash != 0 { _json_scan_check_body(data, i + 1, j); }
                let next: int = _json_scan_next(state);
                if state == 0 or len(act) > top {
                    _json_scan_leaf(ptrs, segs, act, data, state, kesc, key, ks, ke, elem, top, depth, 0, i, j + 1, lw);
                }
                if state == 1 or state == 2 { elem += 1; }
                state = next;
            }
            i = j + 1;
            continue;
        }
        if b == 91 or b == 123 {
            let cont: int = 1; let inner: int = 1;
            if b == 123 { cont = 2; inner = 4; }
            let next: int = _json_scan_next(state);
            let base: int = len(act);
            if state == 0 or base > top {
                _json_scan_leaf(ptrs, segs, act, data, state, kesc, key, ks, ke, elem, top, depth, cont, i, -1, lw);
            }
            if state == 1 or state == 2 { elem += 1; }
            frames.append(next); frames.append(elem); frames.append(top);
            top = base; depth += 1;
            if maxd > 0 and depth > maxd { raise ValueError; }
            state = inner; key = ""; kesc = 0; elem = 0;
        } elif b == 93 or b == 125 {
            let arr: int = 0;
            if b == 93 {
                if state != 1 and state != 3 { raise ValueError; }
                arr = 1;
            } else {
                if state != 4 and state != 8 { raise ValueError; }
            }
            if len(act) > top { _json_scan_close(ptrs, segs, act, top, depth - 1, arr, elem, i + 1, lw); }
            while len(act) > top { act.pop(); }
            top = frames.pop(); elem = frames.pop(); state = frames.pop();
            depth -= 1;
        } elif b == 44 {
            if state == 3 { state = 2; }
            elif state == 8 { state = 5; }
            else { raise ValueError; }
        } else {
            if state != 6 { raise ValueError; }
            state = 7;
        }
        i += 1;
    }
    if depth != 0 or state != 9 { raise ValueError; }
    let values: list[str] = [];
    for ptr in ptrs {
        if ptr.status == 1 { return JsonPointerValues(1, []); }
        if ptr.status == 3 or ptr.e < 0 { return JsonPointerValues(3, []); }
        values.append(_json_render_valid(json_parse_document(data[ptr.s:ptr.e].decode("utf-8"))));
    }
    return JsonPointerValues(0, values);
}

# Same result as json_pointer_scan_bytes(text.encode("utf-8"), pointers).
fn json_pointer_scan_values(text: str, pointers: list[str]) -> JsonPointerValues {
    return json_pointer_scan_bytes(text.encode("utf-8"), pointers);
}

fn _json_scan_raise(found: JsonPointerValues) -> void {
    if found.error == 1 { raise ValueError; }
    if found.error == 3 { raise KeyError; }
}

# Same result as json_pointer_batch_render(json_parse_document(text), pointers).
fn json_pointer_batch_text(text: str, pointers: list[str]) -> str {
    let found: JsonPointerValues = json_pointer_scan_values(text, pointers);
    _json_scan_raise(found);
    return "[" + ",".join(found.values) + "]";
}

# Same result as json_render_document(json_pointer_extract(json_parse_document(text), pointer)).
fn json_pointer_extract_text(text: str, pointer: str) -> str {
    let found: JsonPointerValues = json_pointer_scan_values(text, [pointer]);
    _json_scan_raise(found);
    return found.values[0];
}
