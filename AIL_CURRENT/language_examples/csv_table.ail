# Strict comma CSV over Unicode scalar text; blank records do not consume rows.
struct CsvCell { row: int; column: int; text: str; }

fn csv_parse(text: str) -> list[CsvCell] {
    let cells = [];
    let row = 0; let column = 0; let state = 0;
    let field = ""; let skip_lf = 0;
    for ch in text {
        if skip_lf == 1 and ch == "\n" { skip_lf = 0; continue; }
        skip_lf = 0;
        if state == 2 {
            if ch == "\"" { state = 3; }
            else { field = field + ch; }
        } else {
            if ch == "," or ch == "\r" or ch == "\n" {
                if ch == "," or state != 0 or column != 0 {
                    cells.append(CsvCell(row, column, field));
                    if ch == "," { column += 1; }
                    else { row += 1; column = 0; }
                }
                state = 0; field = "";
                if ch == "\r" { skip_lf = 1; }
            } else {
                if ch == "\"" {
                    if state == 3 { field = field + "\""; state = 2; }
                    else {
                        if state != 0 { raise ValueError; }
                        state = 2;
                    }
                } else {
                    if state == 3 { raise ValueError; }
                    if state == 0 { state = 1; }
                    field = field + ch;
                }
            }
        }
    }
    if state == 2 { raise ValueError; }
    if state != 0 or column != 0 { cells.append(CsvCell(row, column, field)); }
    return cells;
}
