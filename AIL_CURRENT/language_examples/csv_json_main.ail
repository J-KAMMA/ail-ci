fn main() -> int {
    if len(sys.argv) != 2 {
        print("usage: csv_json FILE", file=sys.stderr); return 2;
    }
    try {
        let text = read_bytes(sys.argv[1]).decode();
        let output = csv_json(text);
    } except (OSError, ValueError) {
        print("invalid CSV or unreadable input", file=sys.stderr); return 2;
    }
    print(output); return 0;
}
