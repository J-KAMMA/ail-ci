# Keep the last N little-endian binary64 samples, in input order.
use binary_float64;
use numeric_ring;

fn main() -> int {
    if len(sys.argv) != 4 {
        print("usage: sample_tail <input-f64le> <output-f64le> <capacity>", file=sys.stderr);
        return 2;
    }
    try {
        let ring = sample_ring_new(int(sys.argv[3]));
        let pending = b"";
        for chunk in file_chunks(sys.argv[1], 65536) {
            pending = sample_ring_feed(ring, pending + chunk);
        }
        if len(pending) != 0 { raise ValueError(); }
        write_bytes(sys.argv[2], pack_float64(sample_ring_snapshot(ring), 0));
        return 0;
    } except OSError {
        print("sample data file error", file=sys.stderr);
        return 3;
    } except ValueError {
        print("capacity must be positive and input must contain binary64 samples", file=sys.stderr);
        return 4;
    }
}
