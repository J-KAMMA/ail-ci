use binary_layout;

fn main() -> int {
    if len(sys.argv) != 5 {
        print("usage: binary_layout pad|repeat input output count", file=sys.stderr);
        return 2;
    }
    let mode = sys.argv[1];
    if mode != "pad" and mode != "repeat" {
        print("unknown mode", file=sys.stderr);
        return 2;
    }
    try {
        let count = int(sys.argv[4]);
        let data = read_bytes(sys.argv[2]);
        let result = b"";
        if mode == "pad" { result = binary_pad(data, count); }
        else { result = binary_repeat(data, count); }
        write_bytes(sys.argv[3], result);
        return 0;
    } except ValueError {
        print("invalid count or width", file=sys.stderr);
        return 2;
    } except OSError {
        print("file operation failed", file=sys.stderr);
        return 2;
    }
}
