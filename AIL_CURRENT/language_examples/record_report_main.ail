use record_report;

fn main()->int {
    if len(sys.argv)!=4 {
        print("usage: record_report INPUT OUTPUT MODE",file=sys.stderr);
        return 2;
    }
    try {
        report_run(ReportConfig(ReportPaths(sys.argv[1],sys.argv[2]),sys.argv[3]));
        return 0;
    } except OSError {
        print("record report input or output failed",file=sys.stderr);
        return 3;
    } except ValueError {
        print("invalid UTF-8, CSV, integer, mode, or selected total",file=sys.stderr);
        return 4;
    }
}
