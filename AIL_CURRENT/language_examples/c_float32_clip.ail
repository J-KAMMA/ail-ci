fn main() -> int {
    try {
        let limit = float(sys.argv[3]);
        if limit < 0.0 { raise ValueError; }
        let values = [];
        for word in read_bytes(sys.argv[1]).decode().split() { values.append(float(word)); }
        let result = clip_values(values, limit);
        release_values();
        let output = [];
        for value in result {
            let bits = float_bits(value);
            output.append(bits % 256);
            output.append((bits // 256) % 256);
            output.append((bits // 65536) % 256);
            output.append(bits // 16777216);
        }
        write_bytes(sys.argv[2], bytes(output));
        return 0;
    }
    except ValueError { print("invalid input"); return 2; }
    except OSError { print("file error"); return 3; }
}
