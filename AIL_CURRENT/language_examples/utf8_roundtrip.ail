fn decode_text(data: bytes) -> str {
    return data.decode("utf-8");
}

fn encode_text(text: str) -> bytes {
    return text.encode("utf-8");
}

fn main() -> int {
    let text = decode_text(read_bytes(sys.argv[1]));
    let data = encode_text(text);
    write_bytes(sys.argv[2], data);
    print(len(data));
    return 0;
}
