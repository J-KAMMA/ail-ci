fn _positive_decimal(text: str) -> int {
    let value = 0;
    if len(text) == 0 { raise ValueError; }
    for character in text {
        let digit = ord(character) - 48;
        if digit < 0 or digit > 9 { raise ValueError; }
        if value > 922337203685477580 { raise ValueError; }
        if value == 922337203685477580 and digit > 7 { raise ValueError; }
        value = value * 10 + digit;
    }
    if value == 0 { raise ValueError; }
    return value;
}

fn main() -> int {
    if len(sys.argv) < 1 or len(sys.argv) > 3 { return 2; }
    let first_line = 1;
    let chunk_size = 8192;
    try {
        if len(sys.argv) >= 2 { first_line = _positive_decimal(sys.argv[1]); }
        if len(sys.argv) == 3 { chunk_size = _positive_decimal(sys.argv[2]); }
        number_stdin(first_line, chunk_size);
        return 0;
    } except ValueError { return 2; }
    except OSError { return 3; }
    except RuntimeError { return 4; }
}
