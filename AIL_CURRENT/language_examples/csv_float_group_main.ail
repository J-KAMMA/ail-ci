use checked_integer;
use utf8_stream;
use csv_stream;
use json_text;
use checked_float64;
use csv_float_group;

fn csv_float_group_file(path: str, key_column: int, value_column: int, size: int) -> str {
    if key_column < 0 or value_column < 0 or size <= 0 { raise ValueError; }
    let utf8 = utf8_decoder_new();
    let csv = csv_decoder_new();
    let groups = csv_float_groups_new();
    for chunk in file_chunks(path, size) {
        let rows = csv_decode_feed(csv, utf8_decode_feed(utf8, chunk));
        csv_float_groups_add(groups, rows, key_column, value_column);
    }
    let tail = csv_decode_feed(csv, utf8_decode_finish(utf8));
    csv_float_groups_add(groups, tail, key_column, value_column);
    let final = csv_decode_finish(csv);
    csv_float_groups_add(groups, final, key_column, value_column);
    return csv_float_groups_render(groups);
}

fn main() -> int {
    if len(sys.argv) != 5 {
        print("usage: csv_float_group INPUT KEY_COLUMN VALUE_COLUMN SIZE", file=sys.stderr);
        return 2;
    }
    try {
        let key_column: int = parse_int64_decimal(sys.argv[2]);
        let value_column: int = parse_int64_decimal(sys.argv[3]);
        let size: int = parse_int64_decimal(sys.argv[4]);
        let rendered: str = csv_float_group_file(sys.argv[1], key_column, value_column, size);
        write_stdout_bytes((rendered + "\n").encode("utf-8"));
        flush_stdout();
        return 0;
    } except ValueError {
        print("invalid CSV, UTF-8, column, float, aggregate, or chunk size", file=sys.stderr);
        return 2;
    } except OSError {
        print("CSV float group input or output failed", file=sys.stderr);
        return 2;
    }
}
