use binary_transform;

fn main() -> int {
    if len(sys.argv) != 4 and len(sys.argv) != 5 {
        print("usage: binary_transform translate input table_hex [delete_hex]; binary_transform removeprefix|removesuffix input affix_hex", file=sys.stderr);
        return 2;
    }
    let mode = sys.argv[1];
    if mode != "translate" and mode != "removeprefix" and mode != "removesuffix" {
        print("unknown transform mode", file=sys.stderr);
        return 2;
    }
    if mode != "translate" and len(sys.argv) != 4 {
        print("affix removal requires exactly one hexadecimal affix", file=sys.stderr);
        return 2;
    }
    try {
        let argument = bytes.fromhex(sys.argv[3]);
        let delete = b"";
        if mode == "translate" {
            if len(argument) != 256 { raise ValueError; }
            if len(sys.argv) == 5 { delete = bytes.fromhex(sys.argv[4]); }
        }
        let data = read_bytes(sys.argv[2]);
        let result = b"";
        if mode == "translate" { result = binary_translate(data, argument, delete); }
        if mode == "removeprefix" { result = binary_removeprefix(data, argument); }
        if mode == "removesuffix" { result = binary_removesuffix(data, argument); }
        write_stdout_bytes(result);
        return 0;
    } except ValueError {
        print("invalid hexadecimal value or translation table length", file=sys.stderr);
        return 2;
    } except OSError {
        print("binary input or output failed", file=sys.stderr);
        return 2;
    }
}
