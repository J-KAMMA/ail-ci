use wav_audio;
use checked_integer;
use file_identity;

fn main() -> int {
    if len(sys.argv) != 6 {
        print("usage: wav_audio gain|trim INPUT OUTPUT A B", file=sys.stderr);
        return 2;
    }
    try {
        let mode: str = sys.argv[1];
        if mode != "gain" and mode != "trim" { raise ValueError; }
        let input: str = sys.argv[2];
        let output: str = sys.argv[3];
        let a: int = parse_int64_decimal(sys.argv[4]);
        let b: int = parse_int64_decimal(sys.argv[5]);
        if input == output or file_paths_same(input, output) { raise ValueError; }
        let data: bytes = read_bytes(input);
        let result: bytes = b"";
        if mode == "gain" { result = wav_audio_gain(data, a, b); }
        else { result = wav_audio_trim(data, a, b); }
        write_bytes(output, result);
        return 0;
    } except ValueError {
        print("invalid WAV, parameters, or output alias", file=sys.stderr);
        return 2;
    } except OSError {
        print("WAV file error", file=sys.stderr);
        return 3;
    }
}
