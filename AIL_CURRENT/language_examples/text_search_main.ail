use text_search;
fn main() -> int {
    if len(sys.argv) != 3 {
        print("usage: text_search utf8_input utf8_needle", file=sys.stderr);
        return 2;
    }
    try {
        let text = read_bytes(sys.argv[1]).decode();
        let needle = read_bytes(sys.argv[2]).decode();
        print(text_find(text, needle));
        flush_stdout();
        return 0;
    } except UnicodeDecodeError {
        print("input and needle must be UTF-8", file=sys.stderr);
        return 4;
    } except OSError {
        print("text search file error", file=sys.stderr);
        return 3;
    }
}
