use tar_archive;
use tar_write;
use file_identity;

fn main() -> int {
    if len(sys.argv) != 4 and len(sys.argv) != 5 {
        print("usage: tar normalize INPUT OUTPUT | concat LEFT RIGHT OUTPUT | extract INPUT OUTPUT NAME", file=sys.stderr);
        return 2;
    }
    let mode: str = sys.argv[1];
    if mode != "normalize" and mode != "concat" and mode != "extract" {
        print("unknown tar mode", file=sys.stderr);
        return 2;
    }
    if (mode == "normalize" and len(sys.argv) != 4) or (mode != "normalize" and len(sys.argv) != 5) {
        print("invalid tar argument count", file=sys.stderr);
        return 2;
    }
    try {
        let output_path: str = sys.argv[3];
        if mode == "concat" { output_path = sys.argv[4]; }
        if sys.argv[2] == output_path { raise ValueError; }
        if file_paths_same(sys.argv[2], output_path) { raise ValueError; }
        if mode == "concat" {
            if sys.argv[3] == output_path { raise ValueError; }
            if file_paths_same(sys.argv[3], output_path) { raise ValueError; }
        }
        let entries = tar_entries_decode(read_bytes(sys.argv[2]));
        let output: bytes = b"";
        if mode == "concat" {
            let right = tar_entries_decode(read_bytes(sys.argv[3]));
            for entry in right { entries.append(entry); }
            output = tar_entries_encode(entries);
        } elif mode == "normalize" {
            output = tar_entries_encode(entries);
        } else {
            output = tar_member(entries, sys.argv[4]);
        }
        write_bytes(output_path, output);
        return 0;
    } except ValueError {
        print("invalid tar archive, member, or output path", file=sys.stderr);
        return 2;
    } except KeyError {
        print("tar member not found", file=sys.stderr);
        return 2;
    } except OSError {
        print("tar file error", file=sys.stderr);
        return 2;
    }
}
