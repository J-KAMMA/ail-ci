use binary_writer;
use file_identity;

# Wrap a binary payload in one AILR record after validating paths and kind.
fn main() -> int {
    if len(sys.argv) != 4 {
        print("usage: binary_records_create input-path output-path kind", file=sys.stderr);
        return 2;
    }
    if sys.argv[1] == sys.argv[2] {
        print("input and output paths must differ", file=sys.stderr);
        return 2;
    }
    try {
        # ASCII decimal, with an optional sign; check before each multiplication.
        let wanted = 0;
        let position = 0;
        let negative = False;
        let digits = False;
        for c in sys.argv[3] {
            if position == 0 and (c == "+" or c == "-") { negative = c == "-"; }
            else {
                let digit = ord(c) - 48;
                if digit < 0 or digit > 9 { raise ValueError; }
                if wanted > 6553 or (wanted == 6553 and digit > 5) { raise ValueError; }
                wanted = wanted * 10 + digit;
                digits = True;
            }
            position += 1;
        }
        if not digits or (negative and wanted != 0) { raise ValueError; }
        let data = read_bytes(sys.argv[1]);
        if file_paths_same(sys.argv[1], sys.argv[2]) { raise ValueError; }
        write_bytes(sys.argv[2], binary_record_encode(wanted, data));
        return 0;
    } except ValueError {
        print("invalid kind or binary record payload", file=sys.stderr);
        return 2;
    } except OSError {
        print("binary record file error", file=sys.stderr);
        return 2;
    }
}
