use json_kv_file;
use file_identity;

fn main()->int {
    if len(sys.argv)!=3 {
        print("usage: json_kv INPUT.jsonl STATE.json",file=sys.stderr);return 2;
    }
    try {
        let input=sys.argv[1];let path=sys.argv[2];
        if input==path or file_paths_same(input,path) {raise ValueError;}
        let report=kv_process(path,kv_read(input));
        write_stdout_bytes(report.encode("utf-8"));
        return 0;
    } except ValueError {print("invalid key-value request or state",file=sys.stderr);return 2;}
    except KeyError {print("invalid key-value request",file=sys.stderr);return 2;}
    except OSError {print("key-value file error",file=sys.stderr);return 2;}
}