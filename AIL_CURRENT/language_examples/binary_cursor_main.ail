use binary_cursor;

fn binary_cursor_integer_in_range(text: str) -> int {
    let token = text.strip();
    let negative = token.startswith("-");
    if negative or token.startswith("+") { token = token[1:]; }
    if not token.isdigit() { return 0; }
    token = token.lstrip("0");
    let limit = "9223372036854775807";
    if negative { limit = "9223372036854775808"; }
    return len(token) < 19 or len(token) == 19 and token <= limit;
}

fn main() -> int {
    if len(sys.argv) != 5 {
        print("usage: binary_cursor slice input offset count; binary_cursor rejoin input first second", file=sys.stderr);
        return 2;
    }
    let mode = sys.argv[1];
    if mode != "slice" and mode != "rejoin" {
        print("unknown cursor mode", file=sys.stderr);
        return 2;
    }
    try {
        if not binary_cursor_integer_in_range(sys.argv[3]) or not binary_cursor_integer_in_range(sys.argv[4]) { raise ValueError; }
        let first = int(sys.argv[3]);
        let second = int(sys.argv[4]);
        let data = read_bytes(sys.argv[2]);
        if mode == "slice" { write_stdout_bytes(binary_cursor_slice(data, first, second)); }
        if mode == "rejoin" { write_stdout_bytes(binary_cursor_rejoin(data, first, second)); }
        return 0;
    } except ValueError {
        print("invalid cursor bounds or signed 64-bit integer", file=sys.stderr);
        return 2;
    } except OSError {
        print("binary input or output failed", file=sys.stderr);
        return 2;
    }
}
