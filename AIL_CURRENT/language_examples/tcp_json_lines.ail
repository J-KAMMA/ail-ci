use json_pointer;
use checked_integer;

# LF-delimited UTF-8 JSON; max_line excludes LF and is capped at 1 MiB.
# Replies preserve number lexemes, member order and duplicate members.
# The peer must consume replies while uploading. Readiness waits are per operation;
# sockets must be nonblocking; timeout is not a total request deadline.
# JSON escaping can expand output; each response is bounded by 6 * max_line + 1 bytes.
fn tcp_json_lines(peer: tcpsocket, timeout: int, max_line: int) -> int {
    if timeout <= 0 or timeout > 2147483647 or max_line <= 0 or max_line > 1048576 { raise ValueError; }
    peer.set_blocking(0);
    let pending = bytearray();
    let count: int = 0;
    while True {
        if peer.wait_readable(timeout) == 0 { raise OSError; }
        let chunk: bytes = peer.recv(8192);
        if len(chunk) == 0 {
            if len(pending) != 0 { raise ValueError; }
            return count;
        }
        for octet in chunk {
            if octet == 10 {
                let text: str = bytes(pending).decode("utf-8");
                let response: bytes = (json_render_document(json_parse_document(text)) + "\n").encode("utf-8");
                let offset: int = 0;
                while offset < len(response) {
                    if peer.wait_writable(timeout) == 0 { raise OSError; }
                    let sent: int = peer.send_some(response[offset:]);
                    if sent <= 0 { raise OSError; }
                    offset = checked_int64_add(offset, sent);
                }
                pending.clear();
                count = checked_int64_add(count, 1);
            } else {
                if len(pending) >= max_line { raise ValueError; }
                pending.append(octet);
            }
        }
    }
    return count;
}