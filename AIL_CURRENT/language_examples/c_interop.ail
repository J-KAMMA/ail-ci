# Link the object built from c_interop.c with c_interop.json.
fn main() -> int {
    if len(sys.argv) < 2 { return 2; }
    try {
        let text = open(sys.argv[1]).read();
        print(byte_count(text));
        print(weighted_checksum(text));
        return 0;
    } except OSError { return 3; }
}
