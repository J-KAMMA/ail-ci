# Link with --object artifact.o; the provider source is not needed.
fn main() -> int {
    if len(sys.argv) != 5 {
        print("usage: artifact input output label revision", file=sys.stderr);
        return 2;
    }
    try {
        let item = artifact(sys.argv[3], read_bytes(sys.argv[1]), artifact_revision(sys.argv[4]));
        let copy = with_data(renamed(item, item.label), item.data);
        write_bytes(sys.argv[2], copy.data);
        print(copy.label); print(copy.revision); print(stored_size(copy));
        return 0;
    } except ValueError {
        print("invalid revision", file=sys.stderr);
        return 2;
    } except OSError {
        print("artifact file error", file=sys.stderr);
        return 2;
    }
}
