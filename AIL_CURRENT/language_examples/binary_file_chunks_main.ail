use binary_file_chunks;
use checked_integer;

fn main() -> int {
    if len(sys.argv) != 4 and len(sys.argv) != 5 {
        print("usage: binary_file_chunks stats INPUT SIZE | copy INPUT OUTPUT SIZE", file=sys.stderr);
        return 2;
    }
    let mode: str = sys.argv[1];
    if mode != "stats" and mode != "copy" {
        print("unknown file chunks mode", file=sys.stderr);
        return 2;
    }
    if (mode == "stats" and len(sys.argv) != 4) or (mode == "copy" and len(sys.argv) != 5) {
        print("invalid file chunks argument count", file=sys.stderr);
        return 2;
    }
    try {
        let size: int = parse_int64_decimal(sys.argv[len(sys.argv) - 1]);
        if mode == "stats" {
            let totals: list[int] = file_chunk_totals(sys.argv[2], size);
            let fields: list[str] = [];
            for value in totals { fields.append(str(value)); }
            write_stdout_bytes(("\t".join(fields) + "\n").encode());
        } else { copy_file_chunks(sys.argv[2], sys.argv[3], size); }
        return 0;
    } except ValueError {
        print("invalid chunk size or output path", file=sys.stderr);
        return 2;
    } except OSError {
        print("file chunks input or output failed", file=sys.stderr);
        return 2;
    }
}
