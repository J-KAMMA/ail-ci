use csv_stream;
use checked_integer;
use json_text;

struct CsvGroups {
    counts: dict[str, int];
    totals: dict[str, int];
    minimums: dict[str, int];
    maximums: dict[str, int];
}

struct CsvGroup { key: str; count: int; total: int; minimum: int; maximum: int; }

fn csv_groups_new() -> CsvGroups {
    let empty: dict[str, int] = {};
    return CsvGroups(empty, empty, empty, empty);
}

fn csv_groups_add(groups: CsvGroups, rows: list[CsvRow], key_column: int, value_column: int) -> void {
    if key_column < 0 or value_column < 0 { raise ValueError; }
    let counts: dict[str, int] = groups.counts;
    let totals: dict[str, int] = groups.totals;
    let minimums: dict[str, int] = groups.minimums;
    let maximums: dict[str, int] = groups.maximums;
    for row in rows {
        let fields: list[str] = row.fields;
        if key_column >= len(fields) or value_column >= len(fields) { raise ValueError; }
        let key: str = fields[key_column];
        let value: int = parse_int64_decimal(fields[value_column]);
        if key in counts {
            let total: int = checked_int64_add(totals[key], value);
            let count: int = counts[key];
            if count == 9223372036854775807 { raise ValueError; }
            totals[key] = total;
            counts[key] = count + 1;
            if value < minimums[key] { minimums[key] = value; }
            if value > maximums[key] { maximums[key] = value; }
        } else {
            counts[key] = 1;
            totals[key] = value;
            minimums[key] = value;
            maximums[key] = value;
        }
    }
    groups.counts = counts;
    groups.totals = totals;
    groups.minimums = minimums;
    groups.maximums = maximums;
}

fn csv_groups_snapshot(groups: CsvGroups) -> list[CsvGroup] {
    let counts: dict[str, int] = groups.counts;
    let totals: dict[str, int] = groups.totals;
    let minimums: dict[str, int] = groups.minimums;
    let maximums: dict[str, int] = groups.maximums;
    let result = [];
    for key, count in counts.items() {
        result.append(CsvGroup(key, count, totals[key], minimums[key], maximums[key]));
    }
    return result;
}

fn csv_groups_render(groups: CsvGroups) -> str {
    let rows = csv_groups_snapshot(groups);
    let parts: list[str] = [];
    for row in rows {
        parts.append("{\"key\":" + json_quote(row.key) + ",\"count\":" + str(row.count)
            + ",\"total\":" + str(row.total) + ",\"minimum\":" + str(row.minimum)
            + ",\"maximum\":" + str(row.maximum) + "}");
    }
    return "[" + ",".join(parts) + "]";
}
