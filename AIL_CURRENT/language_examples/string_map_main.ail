use string_map;
use file_identity;

fn main() -> int {
    if len(sys.argv) != 3 {
        print("usage: string_map input-path output-path", file=sys.stderr);
        return 2;
    }
    try {
        let input: str = sys.argv[1];
        let output: str = sys.argv[2];
        if input == output { raise ValueError; }
        if file_paths_same(input, output) { raise ValueError; }
        let data: bytes = read_bytes(input);
        let text: str = data.decode();
        let values: dict[str, str] = string_map_from_config(text);
        let report: str = string_map_render(values);
        write_bytes(output, report.encode());
        return 0;
    } except ValueError {
        print("invalid string map data or output aliases input", file=sys.stderr);
        return 2;
    } except IndexError {
        print("invalid string map entry", file=sys.stderr);
        return 2;
    } except OSError {
        print("string map file error", file=sys.stderr);
        return 2;
    }
}
