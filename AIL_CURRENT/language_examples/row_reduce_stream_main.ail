use integer_row_stream;
# Comparison profile: positive signed int64 CLI counts; ASCII decimal digits only.
fn row_positive_token(text:str)->str {
 if len(text)==0 {raise ValueError;}
 for c in text {
  let digit=ord(c)-48;
  if digit<0 or digit>9 {raise ValueError;}
 }
 let token=text.lstrip("0");
 if len(token)==0 or len(token)>19 {raise ValueError;}
 if len(token)==19 and token>"9223372036854775807" {raise ValueError;}
 return token;
}
fn row_report(values:list[int],cols:int)->str {
 if cols<=0 or len(values)%cols!=0 {raise ValueError;}
 let lines:list[str]=[];
 let total:int=0;
 let column:int=0;
 for value in values {
  if value>0 and total>9223372036854775807-value {raise ValueError;}
  if value<0 and total< -9223372036854775808-value {raise ValueError;}
  total+=value;
  column+=1;
  if column==cols {
   lines.append(str(total)+"\n");
   total=0; column=0;
  }
 }
 return "".join(lines);
}
fn main()->int {
 if len(sys.argv)!=4 {return 2;}
 try {
  let cols_token=row_positive_token(sys.argv[2]);
  let repeat_token=row_positive_token(sys.argv[3]);
  let reader:binaryfile=open_binary(sys.argv[1],"rb");
  let report:bytes=b"";
  try {report=integer_row_report_stream(reader,int(cols_token),65536);} finally {reader.close();}
  if len(report)==0 {return 0;}
  let output:bytes=report;
  for item in range(int(repeat_token)) {write_stdout_bytes(output);}
  return 0;
 } except ValueError {return 2;}
   except OSError {return 2;}
}
