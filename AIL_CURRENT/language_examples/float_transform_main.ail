fn main() -> int {
    let text=read_bytes(sys.argv[1]).decode();
    let words=text.split();
    let values=[];
    for word in words { values.append(float(word)); }
    let factor=float(sys.argv[2]);
    values=scaled(values, factor);
    print(len(values));
    for value in values { print(value); }
    return 0;
}
