fn main() -> int {
    let text = read_bytes(sys.argv[1]).decode();
    let words = text.split();
    let values = [int(word) for word in words];
    let key = int(sys.argv[2]);
    print(native_count_above(values, key));
    let ordered = sorted(values);
    print(native_lower_bound(ordered, key));
    print(len(values));
    return 0;
}
