struct CliArgs { options:dict[str,str]; positional:list[str]; }

fn _cli_name(name:str)->int {
    if len(name)==0 { return 0; }
    for i in range(len(name)) {
        let c=ord(name[i]);
        let letter=(c>=65 and c<=90) or (c>=97 and c<=122);
        if not letter and (i==0 or not ((c>=48 and c<=57) or c==95 or c==45)) {
            return 0;
        }
    }
    return 1;
}

fn cli_parse(args:list[str], value_options:list[str], switch_options:list[str])->CliArgs {
    let kinds:dict[str,str]={};
    for name in value_options {
        if not _cli_name(name) or name in kinds { raise ValueError; }
        kinds[name]="value";
    }
    for name in switch_options {
        if not _cli_name(name) or name in kinds { raise ValueError; }
        kinds[name]="switch";
    }
    let options:dict[str,str]={};
    let positional:list[str]=[];
    let ended=0;
    let i=0;
    while i<len(args) {
        let token=args[i];
        i+=1;
        if ended or not token.startswith("--") {
            positional.append(token);
        } elif token=="--" {
            ended=1;
        } else {
            let body=token[2:];
            let separator=body.find("=");
            let name=body;
            if separator>=0 { name=body[:separator]; }
            if name not in kinds or name in options { raise ValueError; }
            let value="";
            if kinds[name]=="switch" {
                if separator>=0 { raise ValueError; }
            } elif separator>=0 {
                value=body[separator+1:];
            } else {
                if i>=len(args) { raise ValueError; }
                value=args[i];
                if value.startswith("--") { raise ValueError; }
                i+=1;
            }
            options[name]=value;
        }
    }
    return CliArgs(options,positional);
}
