use checked_integer;
use typed_sequences;
use file_identity;

fn main() -> int {
    if len(sys.argv) != 4 {
        print("usage: integer_column_values input-path output-path zero-based-column", file=sys.stderr);
        return 2;
    }
    try {
        let input: str = sys.argv[1];
        let output: str = sys.argv[2];
        let column: int = parse_int64_decimal(sys.argv[3]);
        if column < 0 or input == output { raise ValueError; }
        if file_paths_same(input, output) { raise ValueError; }
        let data: bytes = read_bytes(input);
        let text: str = data.decode();
        let values: list[int] = integer_column_values(text, column);
        let reversed: list[int] = integer_values_reverse(values);
        let report: str = integer_values_render(reversed);
        write_bytes(output, report.encode());
        return 0;
    } except ValueError {
        print("invalid integer column or integer data", file=sys.stderr);
        return 2;
    } except IndexError {
        print("integer column is missing", file=sys.stderr);
        return 2;
    } except OSError {
        print("integer column file error", file=sys.stderr);
        return 2;
    }
}
