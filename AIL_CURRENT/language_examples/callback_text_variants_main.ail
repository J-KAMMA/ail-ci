use callback_text_pipeline;

fn trim_line(line: str) -> str {
    return line.strip();
}

fn frame_line(line: str) -> str {
    return "[" + line + "]";
}

# Read once, then produce both UTF-8 variants using the same reusable pipeline.
fn main() -> int {
    if len(sys.argv) != 3 {
        print("usage: callback_text_variants <utf8-input> <output-prefix>", file=sys.stderr);
        return 2;
    }
    try {
        let text = read_bytes(sys.argv[1]).decode();
        for mode in ["trim", "frame"] {
            let operation: Callable[[str], str] = trim_line;
            if mode == "frame" { operation = frame_line; }
            let output = rewrite_lines(text, operation);
            write_bytes(sys.argv[2] + "." + mode + ".txt", output.encode());
        }
        return 0;
    } except UnicodeDecodeError {
        print("input must be UTF-8", file=sys.stderr);
        return 4;
    } except ValueError {
        print("invalid text transformation", file=sys.stderr);
        return 4;
    } except OSError {
        print("text variants file error", file=sys.stderr);
        return 3;
    }
}
