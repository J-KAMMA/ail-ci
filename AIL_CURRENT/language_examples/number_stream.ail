fn _number_stdin_chunk(size: int, initial_state: int) -> int {
    let data = read_stdin_bytes(size);
    if len(data) == 0 { return 0; }
    let state = initial_state;
    let begin = 0;
    for position in range(len(data)) {
        if state == -9223372036854775808 { raise RuntimeError; }
        if state > 0 {
            let prefix = str(state) + ": ";
            write_stdout_bytes(prefix.encode());
            state = -state;
        }
        if data[position] == 10 {
            write_stdout_bytes(data[begin:position + 1]);
            begin = position + 1;
            if state == -9223372036854775807 {
                state = -9223372036854775808;
            } else {
                state = -state + 1;
            }
        }
    }
    if begin < len(data) { write_stdout_bytes(data[begin:]); }
    return state;
}

fn number_stdin(first_line: int, chunk_size: int) -> void {
    if first_line <= 0 or chunk_size <= 0 { raise ValueError; }
    let state = first_line;
    while true {
        state = _number_stdin_chunk(chunk_size, state);
        if state == 0 { break; }
    }
}
