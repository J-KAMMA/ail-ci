use binary_search;
use checked_integer;

fn main() -> int {
    if len(sys.argv) != 4 and len(sys.argv) != 6 {
        print("usage: binary_search find|rfind|count|startswith|endswith input needle_hex [start end]", file=sys.stderr);
        return 2;
    }
    let mode = sys.argv[1];
    if mode != "find" and mode != "rfind" and mode != "count" and mode != "startswith" and mode != "endswith" {
        print("unknown search mode", file=sys.stderr);
        return 2;
    }
    try {
        let needle = bytes.fromhex(sys.argv[3]);
        let start = 0;
        let end = 9223372036854775807;
        if len(sys.argv) == 6 {
            start = parse_int64_text(sys.argv[4]);
            end = parse_int64_text(sys.argv[5]);
        }
        let data = read_bytes(sys.argv[2]);
        let result = 0;
        if mode == "find" { result = binary_find(data, needle, start, end); }
        if mode == "rfind" { result = binary_rfind(data, needle, start, end); }
        if mode == "count" { result = binary_count(data, needle, start, end); }
        if mode == "startswith" { result = binary_startswith(data, needle, start, end); }
        if mode == "endswith" { result = binary_endswith(data, needle, start, end); }
        try {
            print(result);
            flush_stdout();
        } except OSError {
            print("output write failed", file=sys.stderr);
            return 2;
        }
        return 0;
    } except ValueError {
        print("invalid hexadecimal needle or search range", file=sys.stderr);
        return 2;
    } except OSError {
        print("input read failed", file=sys.stderr);
        return 2;
    }
}
