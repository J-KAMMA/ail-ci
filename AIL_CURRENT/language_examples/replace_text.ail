fn replace_text(text: str, old: str, replacement: str, count: int) -> str {
    return text.replace(old, replacement, count);
}

fn main() -> int {
    let text = read_bytes(sys.argv[1]).decode();
    let result = replace_text(text, sys.argv[3], sys.argv[4], int(sys.argv[5]));
    write_bytes(sys.argv[2], result.encode());
    return 0;
}
