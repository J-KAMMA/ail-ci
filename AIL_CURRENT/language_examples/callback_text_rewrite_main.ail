use callback_text_pipeline;

fn trim_line(line: str) -> str {
    return line.strip();
}

fn frame_line(line: str) -> str {
    return "[" + line + "]";
}

# Decode and encode UTF-8 explicitly; no platform newline translation.
fn main() -> int {
    if len(sys.argv) != 4 {
        print("usage: callback_text_rewrite <utf8-input> <utf8-output> trim|frame", file=sys.stderr);
        return 2;
    }
    let mode = sys.argv[3];
    if mode != "trim" and mode != "frame" {
        print("mode must be trim or frame", file=sys.stderr);
        return 2;
    }
    try {
        let text = read_bytes(sys.argv[1]).decode();
        let output = "";
        if mode == "trim" {
            output = rewrite_lines(text, trim_line);
        } else {
            output = rewrite_lines(text, frame_line);
        }
        write_bytes(sys.argv[2], output.encode());
        return 0;
    } except UnicodeDecodeError {
        print("input must be UTF-8", file=sys.stderr);
        return 4;
    } except ValueError {
        print("invalid text transformation", file=sys.stderr);
        return 4;
    } except OSError {
        print("text rewrite file error", file=sys.stderr);
        return 3;
    }
}
