use number_lines_core;

fn main() -> int {
    if len(sys.argv) != 3 {
        print("usage: number_lines <utf8-input> <utf8-output>", file=sys.stderr);
        return 2;
    }
    try {
        let output = number_lines(open(sys.argv[1]).read());
        write_text(sys.argv[2], output);
        print(len(output));
    } except OSError {
        print("file error", file=sys.stderr);
        return 3;
    }
    return 0;
}
