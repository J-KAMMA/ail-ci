use csv_writer;
use csv_stream;
use file_identity;

# Whole-file normalization, not an unbounded streaming interface.
# Existing CSV decoder ignores blank records; emitted records always end CRLF.
# Input validation precedes output opening; output write failures are not atomic.
fn main() -> int {
    if len(sys.argv) != 3 {
        print("usage: csv_rewrite INPUT OUTPUT", file=sys.stderr); return 2;
    }
    try {
        let input: str = sys.argv[1];
        let output: str = sys.argv[2];
        if input == output or file_paths_same(input, output) { raise ValueError; }
        let text: str = read_bytes(input).decode("utf-8");
        let decoder: CsvDecoder = csv_decoder_new();
        let rows: list[CsvRow] = csv_decode_feed(decoder, text);
        rows.extend(csv_decode_finish(decoder));
        let parts: list[str] = [];
        for row in rows { parts.append(csv_encode_row(row.fields)); }
        let encoded: bytes = "".join(parts).encode("utf-8");
        write_bytes(output, encoded);
        return 0;
    } except UnicodeDecodeError {
        print("invalid UTF-8 CSV input", file=sys.stderr); return 4;
    } except ValueError {
        print("invalid CSV input or output alias", file=sys.stderr); return 4;
    } except OSError {
        print("CSV rewrite file error", file=sys.stderr); return 3;
    }
}