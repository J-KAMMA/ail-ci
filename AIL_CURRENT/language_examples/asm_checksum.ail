# Input is a whole file of little-endian int64 words; the checksum wraps modulo 2^64.
fn checksum(data: bytes) -> int {
    let count = len(data) // 8;
    let total = 0;
    let index = 0;
    while index < count {
        total = checksum_step(total,
            checksum_word(data, index), checksum_word(data, index + 1),
            checksum_word(data, index + 2), checksum_word(data, index + 3),
            checksum_word(data, index + 4), checksum_word(data, index + 5));
        index += 6;
    }
    return total;
}

fn main() -> int {
    if len(sys.argv) != 2 { return 2; }
    try {
        let data = read_bytes(sys.argv[1]);
        if len(data) % 8 != 0 { return 2; }
        print(checksum(data));
        return 0;
    } except OSError { return 3; }
}
