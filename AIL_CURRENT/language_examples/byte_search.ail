fn main() -> int {
    if len(sys.argv) < 3 or len(sys.argv) > 5 {
        print("usage: byte_search file byte [start [end]]", file=sys.stderr);
        return 2;
    }
    try {
        let value = int(sys.argv[2]);
        let start = 0;
        let end = 9223372036854775807;
        if len(sys.argv) >= 4 { start = int(sys.argv[3]); }
        if len(sys.argv) >= 5 { end = int(sys.argv[4]); }
        if value < 0 or value > 255 { raise ValueError(); }
        let data = read_bytes(sys.argv[1]);
        print(find_byte(data, value, start, end));
    } except ValueError {
        print("invalid byte or position", file=sys.stderr);
        return 3;
    } except OSError {
        print("cannot read input", file=sys.stderr);
        return 4;
    }
    return 0;
}
