use checked_integer;
use integer_column_stats;
use file_identity;

fn main() -> int {
    if len(sys.argv) != 4 {
        print("usage: integer_column_stats input-path output-path zero-based-column", file=sys.stderr);
        return 2;
    }
    try {
        let input: str = sys.argv[1];
        let output: str = sys.argv[2];
        let column: int = parse_int64_decimal(sys.argv[3]);
        if column < 0 or input == output { raise ValueError; }
        if file_paths_same(input, output) { raise ValueError; }
        let data: bytes = read_bytes(input);
        let stats: IntegerColumnStats = integer_column_stats_bytes(data, column);
        let report: str = integer_column_stats_render(stats);
        write_bytes(output, report.encode());
        return 0;
    } except ValueError {
        print("invalid integer column or integer data", file=sys.stderr);
        return 2;
    } except IndexError {
        print("integer column is missing", file=sys.stderr);
        return 2;
    } except UnicodeDecodeError {
        print("input must be UTF-8", file=sys.stderr);
        return 2;
    } except OSError {
        print("integer column file error", file=sys.stderr);
        return 2;
    }
}
