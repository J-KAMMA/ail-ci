use directory_catalog;

fn main() -> int {
    if len(sys.argv) != 2 {
        print("usage: directory_catalog DIRECTORY", file=sys.stderr);
        return 2;
    }
    try {
        print(directory_catalog(sys.argv[1]));
        return 0;
    } except OSError {
        print("directory access failed", file=sys.stderr);
        return 3;
    } except ValueError {
        print("invalid directory path or Unicode name", file=sys.stderr);
        return 4;
    }
}
